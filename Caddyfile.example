# Example TLS edge for the connector's API. Copy next to compose.example.yaml
# as Caddyfile and set CONNECTOR_HOST in the Compose environment.
#
# The certificate comes from files in ./certs (fullchain.pem, privkey.pem),
# issued elsewhere. Caddy reads them only when its configuration loads, and a
# plain `caddy reload` of an unchanged Caddyfile keeps the old certificate.
# Whatever installs a renewed certificate must therefore restart the container
# or force a reload:
#   docker compose exec caddy caddy reload --force --config /etc/caddy/Caddyfile
{
	# Only 443 is published; nothing answers plain HTTP.
	auto_https disable_redirects

	servers {
		# The API's own socket timeout applies to each receive, not to a whole
		# request, so a client trickling a request could hold a handler thread.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$CONNECTOR_HOST} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# The connector sees only Caddy's address, so the client of a request is
	# recorded here. Caddy redacts the Authorization header in access logs.
	log

	# The API refuses bodies over 64 KiB; refuse them here before they reach it.
	request_body {
		max_size 64KiB
	}

	# No write timeout: /push and /rerun can wait up to four minutes before
	# answering.
	reverse_proxy connector:8080
}
